# Copy to .env.local and fill in. .env.local is gitignored.
# These are the PUBLIC keys — safe to ship in the frontend bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# The values below are NOT used by the frontend. They belong in the Vercel
# project settings (Settings → Environment Variables), never in this file and
# never committed. Listed here only as a checklist of what api/trades.js needs:
#
#   NT8_WEBHOOK_SECRET   = <random 32-char hex, must match the NT8 strategy>
#   SUPABASE_URL         = https://your-project.supabase.co
#   SUPABASE_SERVICE_KEY = <service_role key — bypasses RLS, server-only>
